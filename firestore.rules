rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global primitives
    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidEmail(email) {
      return email is string
        && email.size() >= 5
        && email.size() <= 254
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$');
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'source'])
        && data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'source'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && isValidEmail(data.email)
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 2000
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.source is string
        && data.source.size() == 13
        && data.source == 'portfolio-web';
    }

    // Write-only public contact inbox.
    // Visitors can submit strictly validated messages; all reads, updates, and deletes are denied.
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming());
      allow read, update, delete: if false;
    }
  }
}
